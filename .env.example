# Build-time configuration. Neither variable is needed for local development --
# the defaults are the local ones -- and both are set by
# .github/workflows/deploy.yml for the Pages build.
#
# Copy to .env.local to override.

# Vite's base path. "/" for a local server or a domain root; "/<repo>/" for a
# GitHub Pages project site, which is what this deploys as.
VITE_BASE=/

# Where the scanned source PDFs are read from.
#
# Unset (the default) means the /pdf/ dev mount in vite.config.js, which serves
# them out of the sibling nyc-executive-orders checkout. Set, it must be a base
# URL that repo-relative pdf_path values resolve against -- and the TRAILING
# SLASH matters, though src/paths.js forces one if you forget.
#
# The deploy points this at media.githubusercontent.com, the only GitHub host
# that resolves a git-LFS pointer to the file behind it, pinned to the commit
# the build read the corpus from. Note that pdf.js cannot detect range support
# there (CORS hides Accept-Ranges), so PdfViewer supplies its own range
# transport whenever this is set; see the comments in that component.
#
# VITE_MEDIA_BASE=https://media.githubusercontent.com/media/BetaNYC/nyc-executive-orders/main/

# Where the data build reads from, if the data repo is not a sibling directory.
# EO_CORPUS_DIR=/path/to/nyc-executive-orders/corpus
# EO_PICS_DIR=/path/to/nyc-executive-orders/vlm-pics-web
# EO_REPO_DIR=/path/to/nyc-executive-orders
